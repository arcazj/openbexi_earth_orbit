server {
    listen 0.0.0.0:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    autoindex off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # The public surface is read-only: curated assets and validated data aliases.
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    location = /api/data-update-status {
        proxy_pass http://127.0.0.1:8000;
        proxy_read_timeout 30s;
    }
    location ~ "^/json/(gp/GP\.(json|meta\.json)|tle/TLE\.(json|meta\.json)|launches/launches\.(json|meta\.json)|decayed/decayed\.(json|meta\.json)|tracked/(TRACKED\.(manifest|meta)\.json|chunks/[a-f0-9]{64}-[a-z0-9-]+\.json))$" {
        proxy_pass http://127.0.0.1:8000;
        proxy_read_timeout 30s;
    }
    location /api/ { return 404; }

    location / {
        try_files $uri $uri/ =404;
    }
}

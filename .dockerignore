!release/version.json
!index.html
!markdown_viewer.html
!swagger.html
!README.md
!RELEASE_NOTES.md
!LICENSE.md
!SWAGGER.md
!css/
!css/**
!data/
!data/ephemeris/
!data/ephemeris/**
!data/stars/
!data/stars/**
!icons/
!icons/**
!js/
!js/**
!json/
!json/satcat.csv
!json/satcat.meta.json
!json/decayed/
!json/decayed/**

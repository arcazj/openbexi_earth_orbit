!json/gp/**
!json/launches/
!json/launches/**
!json/satellites/
!json/satellites/**
!json/tle/
!json/tle/**
!json/tracked/
!json/tracked/**
!obj/
!obj/**
!textures/
!textures/**
!vendor/
!vendor/**
**/.env
**/.env.*
**/*.bak-*
**/*.tmp
**/__pycache__/**
**/*.pyc
